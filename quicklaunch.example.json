{
  "version": 1,
  "launches": [
    {
      "name": "lazygit",
      "argv": ["lazygit"],
      "cwd": { "policy": "focused" }
    },
    {
      "name": "build",
      "argv": ["make", "build"],
      "cwd": { "policy": "focused" },
      "keep_open": true
    },
    {
      "name": "htop",
      "argv": ["htop"],
      "cwd": { "policy": "home" }
    },
    {
      "name": "agent-demo",
      "argv": ["/bin/sleep", "3600"],
      "cwd": { "policy": "focused" },
      "new_pane": true,
      "keep_open": true
    }
  ]
}
