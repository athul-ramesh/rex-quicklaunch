{
  "version": 1,
  "launches": [
    {
      "name": "lazygit",
      "label": "git UI",
      "argv": ["lazygit"],
      "cwd": { "policy": "focused" },
      "bounds": { "x": 0.1, "y": 0.1, "w": 0.8, "h": 0.8 }
    },
    {
      "name": "build",
      "argv": ["make", "build"],
      "cwd": { "policy": "focused" },
      "keep_open": true
    },
    {
      "name": "htop",
      "argv": ["htop"],
      "cwd": { "policy": "home" }
    },
    {
      "name": "agent-demo",
      "argv": ["/bin/sleep", "3600"],
      "cwd": { "policy": "focused" },
      "keep_open": true,
      "place": "right",
      "reuse": true,
      "key": "cmd+shift+a"
    },
    {
      "name": "notes",
      "argv": ["/bin/zsh"],
      "cwd": { "policy": "home" },
      "keep_open": true,
      "prompt": [{ "id": "line", "title": "First line", "default": "# " }],
      "initial_input": "{{line}}\n"
    }
  ]
}